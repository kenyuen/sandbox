meta {
  name: update_doc_script
  type: http
  seq: 8
}

post {
  url: {{host}}/{{index}}/_update/100
  body: json
  auth: inherit
}

body:json {
  // using script to update in_stock value with noop
  {
    "script": {
      "source": "if (ctx._source.in_stock ==0) { ctx.op ='noop';} ctx._source.in_stock--;"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
